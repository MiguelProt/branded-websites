<script>
  (function () {
    if (document.body.classList.contains('design-11') || document.body.classList.contains('design-12') || document.body.classList.contains('design-13')) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var hero = document.querySelector('.hero');
    var progress = document.createElement('div');
    progress.className = 'motion-progress';
    progress.setAttribute('aria-hidden', 'true');
    document.body.appendChild(progress);

    if (hero) {
      var heroItems = Array.from(hero.querySelectorAll('h1, .eyebrow, blockquote, .hero-positioning, .trust-summary, .tp-rating-badge, [class*="hero-photo"], [class*="portrait"], [class*="actions"], [class*="cta"]'));
      heroItems = heroItems.filter(function (item, index, items) {
        return !items.some(function (parent, parentIndex) { return parentIndex !== index && parent.contains(item); });
      });
      heroItems.forEach(function (item, index) {
        item.classList.add('motion-hero');
        item.style.setProperty('--motion-delay', (120 + index * 130) + 'ms');
      });
      hero.querySelectorAll('img').forEach(function (image) {
        (image.parentElement || image).classList.add('motion-hero-image');
      });
    }

    var sections = Array.from(document.querySelectorAll('section:not(.hero), main > div, .dc-layout, footer'));
    var revealItems = [];
    var imageItems = [];
    sections.forEach(function (section, sectionIndex) {
      var scope = section.querySelector(':scope > .container') || section;
      var candidates = Array.from(scope.children).filter(function (item) {
        return !item.matches('script, style');
      });
      if (candidates.length === 1 && candidates[0].children.length > 1) {
        candidates = Array.from(candidates[0].children);
      }
      candidates.slice(0, 8).forEach(function (item, index) {
        item.classList.add('motion-reveal');
        item.dataset.motionSide = (sectionIndex + index) % 2 ? 'right' : 'left';
        item.style.setProperty('--motion-delay', (index * 85) + 'ms');
        revealItems.push(item);
      });
      section.querySelectorAll('img').forEach(function (image, index) {
        var frame = image.parentElement && image.parentElement.children.length === 1 ? image.parentElement : image;
        frame.classList.add('motion-image');
        frame.style.setProperty('--motion-delay', (index * 90) + 'ms');
        imageItems.push(frame);
      });
    });

    var animated = Array.from(new Set(revealItems.concat(imageItems)));
    if (reduced || !('IntersectionObserver' in window)) {
      animated.forEach(function (item) { item.classList.add('is-visible'); });
      document.body.classList.add('motion-loaded');
    } else {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: .14, rootMargin: '0px 0px -5% 0px' });
      animated.forEach(function (item) { observer.observe(item); });
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { document.body.classList.add('motion-loaded'); });
      });
    }

    var ticking = false;
    function updateProgress() {
      var max = document.documentElement.scrollHeight - innerHeight;
      document.body.style.setProperty('--motion-progress', max > 0 ? Math.min(1, scrollY / max) : 0);
      ticking = false;
    }
    addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(updateProgress); }
    }, { passive: true });
    updateProgress();
  })();
</script>
