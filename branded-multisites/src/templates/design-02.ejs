<!doctype html>
<html lang="en">
<%- include('partials/head', data) %>
<body class="design-02">
<%- include('partials/nav', data) %>

<div class="firm-strip">
  <div class="container firm-strip-inner">
    <span><%= advisor.identity.location %></span>
    <span class="firm-strip-sep" aria-hidden="true">&middot;</span>
    <a href="tel:<%= advisor.contact.phone.replace(/[^\d+]/g, '') %>"><%= advisor.contact.phone %></a>
  </div>
</div>

<main>
  <section class="hero firm-hero">
    <div class="container firm-hero-grid">
      <div class="firm-hero-copy">
        <p class="eyebrow"><%= advisor.identity.headline %></p>
        <h1><%= advisor.identity.name %></h1>
        <p class="firm-hero-positioning"><%= advisor.identity.positioning %></p>
        <%- include('partials/trust', data) %>
      </div>
      <div class="firm-hero-media">
        <img class="firm-hero-photo" src="<%= images.headshot.src %>" alt="<%= images.headshot.alt %>" width="<%= images.headshot.width %>" height="<%= images.headshot.height %>" fetchpriority="high">
      </div>
    </div>
  </section>

  <section class="section firm-story" id="story">
    <div class="container narrow">
      <p class="eyebrow">Welcome</p>
      <h2><%= advisor.professional.story.title %></h2>
      <blockquote class="firm-quote">&ldquo;<%= advisor.professional.story.quote %>&rdquo;</blockquote>
      <% advisor.professional.story.paragraphs.forEach((paragraph, i) => { %><p<%= i === 0 ? ' class="lead-copy"' : '' %>><%= paragraph %></p><% }) %>
    </div>
  </section>

  <section class="section firm-credentials" id="credentials">
    <div class="container">
      <p class="eyebrow">Credentials</p>
      <%- include('partials/credentials', data) %>
    </div>
  </section>

  <section class="section firm-lifestyle" id="lifestyle">
    <div class="container firm-lifestyle-grid">
      <div class="firm-lifestyle-photos">
        <% advisor.personal.lifestylePhotos.slice(1, 2).forEach(image => { %>
          <img src="<%= image.src %>" alt="<%= image.alt %>" width="<%= image.width %>" height="<%= image.height %>" loading="lazy">
        <% }) %>
      </div>
      <div class="firm-lifestyle-copy">
        <p class="eyebrow">Beyond retirement planning</p>
        <h2><%= advisor.personal.moreAboutMe.title %></h2>
        <% advisor.personal.moreAboutMe.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %>
      </div>
    </div>
  </section>

  <%- include('partials/reviews', data) %>
  <%
    const contactData = {
      ...data,
      advisor: {
        ...advisor,
        contact: {
          ...advisor.contact,
          form: { ...advisor.contact.form, submitLabel: 'Send' }
        }
      }
    };
  %>
  <%- include('partials/contact', contactData) %>
  <%- include('partials/faq', data) %>
</main>
<%- include('partials/footer', data) %>
<%- include('partials/schema', data) %>
</body></html>
