<!doctype html>
<html lang="en">
<%- include('partials/head', data) %>
<body class="design-10">
<%- include('partials/nav', data) %>
<main>
  <section class="hero hero-executive">
    <div class="container executive-grid">
      <div class="executive-copy">
        <span class="line-label">Independent advisor profile</span>
        <h1><%= advisor.identity.name %></h1>
        <p class="executive-role"><%= advisor.identity.headline %></p>
        <p class="hero-positioning"><%= advisor.identity.positioning %></p>
        <div class="executive-actions">
          <a class="executive-primary-cta" href="#contact">Start a conversation <span aria-hidden="true">&rarr;</span></a>
          <a class="executive-phone-cta" href="tel:<%= advisor.contact.phone.replace(/[^\d+]/g, '') %>">Call <%= advisor.identity.firstName %> · <%= advisor.contact.phone %></a>
        </div>
        <div class="executive-proof">
          <% if (advisor.trust.trustpilot.enabled && advisor.trust.trustpilot.reviewCount) { %>
            <a class="tp-rating-badge" href="<%= advisor.trust.trustpilot.profileUrl %>" target="_blank" rel="noopener noreferrer" aria-label="View Trustpilot profile">
              <p class="tp-review-count">Based on <%= Number(advisor.trust.trustpilot.reviewCount).toLocaleString() %> reviews</p>
              <span class="tp-stars-row" aria-hidden="true">
                <% for (let i = 1; i <= 5; i++) { const fill = Math.max(0, Math.min(1, Number(advisor.trust.trustpilot.rating) - (i - 1))); %>
                  <span class="tp-star-cell">
                    <span class="tp-star-fill" style="width:<%= (fill * 100).toFixed(0) %>%"></span>
                    <span class="tp-star-icon"></span>
                  </span>
                <% } %>
              </span>
              <span class="tp-logo" aria-hidden="true">
                <span class="tp-logo-star"></span>
                <span class="tp-logo-text">Trustpilot</span>
              </span>
            </a>
          <% } else { %>
            <div class="trust-summary trust-summary--fallback">
              <strong>Professional guidance</strong>
              <span>Clear, personal, no-pressure conversations</span>
            </div>
          <% } %>
        </div>
      </div>
      <div class="executive-photo"><img src="<%= images.headshot.src %>" alt="<%= images.headshot.alt %>" width="<%= images.headshot.width %>" height="<%= images.headshot.height %>" fetchpriority="high"></div>
    </div>
  </section>

  <section class="section executive-creds" id="credentials"><div class="container"><%- include('partials/credentials', data) %></div></section>

  <section class="section executive-story bg-gray" id="story">
    <div class="container executive-story-grid">
      <div>
        <h2>Clear advice.<br />Personal context.<br />No unnecessary complexity.</h2>
        <blockquote>“<%= advisor.professional.story.quote %>”</blockquote>
      </div>
      <div><% advisor.professional.story.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %></div>
    </div>
  </section>

  <section class="section reviews-section" id="reviews" aria-labelledby="reviews-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Client feedback</p>
        <h2 id="reviews-title">What clients say</h2>
      </div>

      <div class="review-carousel">
        <div class="review-grid" id="review-grid">
          <% optional.reviews.forEach(review => { %>
            <figure class="review-card">
              <blockquote>“<%= review.quote %>”</blockquote>
              <figcaption class="review-author">
                <span class="review-avatar"><%= review.author.trim().charAt(0).toUpperCase() %></span>
                <strong><%= review.author %></strong>
              </figcaption>
            </figure>
          <% }) %>
        </div>
        <button type="button" class="review-arrow review-arrow-prev" data-review-prev aria-label="Previous testimonial">‹</button>
        <button type="button" class="review-arrow review-arrow-next" data-review-next aria-label="Next testimonial">›</button>
      </div>

      <% if (advisor.trust.trustpilot.enabled && advisor.trust.trustpilot.reviewCount) { %>
        <div class="trust-bar">
          <a href="<%= advisor.trust.trustpilot.profileUrl %>" target="_blank" rel="noopener noreferrer" class="trust-bar-link">
            <span class="trust-bar-stars" aria-hidden="true"><% for (let i = 0; i < 5; i++) { %><svg class="trust-bar-star" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg><% } %></span>
            <strong><%= advisor.trust.trustpilot.rating %> / 5</strong>
            <span><%= Number(advisor.trust.trustpilot.reviewCount).toLocaleString() %> verified reviews on Trustpilot</span>
          </a>
        </div>
      <% } %>
    </div>
  </section>

  <script>
    (function () {
      var grid = document.getElementById('review-grid');
      var prev = document.querySelector('[data-review-prev]');
      var next = document.querySelector('[data-review-next]');
      if (!grid || !prev || !next) return;
      function scrollByCard(direction) {
        var card = grid.querySelector('.review-card');
        if (!card) return;
        var gap = parseFloat(getComputedStyle(grid).columnGap) || 0;
        grid.scrollBy({ left: direction * (card.getBoundingClientRect().width + gap), behavior: 'smooth' });
      }
      prev.addEventListener('click', function () { scrollByCard(-1); });
      next.addEventListener('click', function () { scrollByCard(1); });
    })();
  </script>

  <section class="section lifestyle-section" id="lifestyle">
    <div class="container">
      <span class="line-label">Beyond the office</span>
      <h2><%= advisor.personal.moreAboutMe.title %></h2>
      <div class="lifestyle-grid">
        <div class="photo-stack">
          <% advisor.personal.lifestylePhotos.forEach(photo => { %><img src="<%= photo.src %>" alt="<%= photo.alt %>" width="<%= photo.width %>" height="<%= photo.height %>" loading="lazy"><% }) %>
        </div>
        <div class="lifestyle-copy"><% advisor.personal.moreAboutMe.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %></div>
      </div>
    </div>
  </section>

  <%- include('partials/faq', data).trim() %>

  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div class="contact-info">
        <img class="contact-photo" src="<%= images.contactPhoto.src %>" alt="<%= images.contactPhoto.alt %>" width="<%= images.contactPhoto.width %>" height="<%= images.contactPhoto.height %>" loading="lazy">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title"><%= advisor.contact.title %></h2>
        <p><%= advisor.contact.intro %></p>
        <p class="contact-location"><%= advisor.identity.location %></p>
        <p class="phone-link"><a href="tel:<%= advisor.contact.phone.replace(/[^\d+]/g, '') %>"><%= advisor.contact.phone %></a></p>
      </div>

      <form class="contact-form" method="<%= advisor.contact.form.method %>" action="<%= advisor.contact.form.action %>">
        <% advisor.contact.form.fields.forEach(field => { %>
          <div class="field">
            <div class="field-head">
              <label for="<%= field.name %>"><%= field.label %></label>
              <% if (!field.required) { %><span class="field-optional">Optional</span><% } %>
            </div>
            <% if (field.type === 'textarea') { %>
              <textarea id="<%= field.name %>" name="<%= field.name %>" autocomplete="<%= field.autocomplete %>" <%= field.required ? 'required' : '' %>></textarea>
            <% } else { %>
              <input id="<%= field.name %>" name="<%= field.name %>" type="<%= field.type %>" autocomplete="<%= field.autocomplete %>" <%= field.required ? 'required' : '' %>>
            <% } %>
          </div>
        <% }) %>

        <button type="submit">Send my question <span aria-hidden="true">&rarr;</span></button>
        <p class="confidentiality">Your information is confidential and used only to respond to your request.</p>
      </form>
    </div>
  </section>
</main>
<%- include('partials/footer', data) %>
<%- include('partials/schema', data) %>
</body></html>
