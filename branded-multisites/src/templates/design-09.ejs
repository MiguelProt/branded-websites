<!doctype html>
<html lang="en">
<%- include('partials/head', data) %>
<body class="design-09">
<%- include('partials/nav', data) %>
<main>
  <section class="hero hero-liquid">
    <div class="container liquid-hero-grid">
      <div class="liquid-card liquid-hero-card">
        <div class="magazine-kicker"><span>Advisor profile</span><span>Nationwide</span></div>
        <h1><%= advisor.identity.name %></h1>
        <p class="hero-role"><%= advisor.identity.headline %></p>
        <p class="hero-positioning"><%= advisor.identity.positioning %></p>
        <%- include('partials/trust', data) %>
      </div>
      <div class="liquid-hero-photo">
        <img src="<%= images.headshot.src %>" alt="<%= images.headshot.alt %>" width="<%= images.headshot.width %>" height="<%= images.headshot.height %>" fetchpriority="high">
      </div>
    </div>
  </section>

  <section class="section magazine-story" id="story">
    <div class="container">
      <div class="magazine-story-title"><span>01</span><h2>Story</h2></div>
      <div class="liquid-card magazine-story-copy"><% advisor.professional.story.paragraphs.forEach((paragraph, i) => { %><p<%= i === 0 ? ' class="lead-copy"' : '' %>><%= paragraph %></p><% }) %></div>
    </div>
    ext
  </section>

  <section class="section lifestyle-section" id="lifestyle">
    <div class="container">
      <div class="magazine-story-title"><span>02</span><h2><%= advisor.personal.moreAboutMe.title %></h2></div>
      <div class="lifestyle-grid">
        <% advisor.personal.lifestylePhotos.forEach(photo => { %><img src="<%= photo.src %>" alt="<%= photo.alt %>" width="<%= photo.width %>" height="<%= photo.height %>" loading="lazy"><% }) %>
        <div class="liquid-card lifestyle-copy"><% advisor.personal.moreAboutMe.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %></div>
      </div>
    </div>
  </section>

  <section class="section magazine-proof" id="credentials">
    <div class="container"><div class="magazine-story-title"><span>03</span><h2>Credentials</h2></div><%- include('partials/credentials', data) %></div>
  </section>

  <%- include('partials/reviews', data) %>
  <%- include('partials/contact', data) %>
  <%- include('partials/faq', data) %>
</main>
<%- include('partials/footer', data) %>
<%- include('partials/schema', data) %>
</body></html>
