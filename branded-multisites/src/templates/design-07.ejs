<!doctype html>
<html lang="en">
<%- include('partials/head', data) %>
<body class="design-07">
<%- include('partials/nav', data) %>
<main>
  <section class="hero hero-credentials-first">
    <div class="container">
      <div class="credentials-top" id="credentials"><%- include('partials/credentials', data) %></div>
      <div class="cred-hero-grid">
        <div>
          <p class="eyebrow"><%= advisor.identity.headline %></p>
          <h1><%= advisor.identity.name %></h1>
          <p class="hero-positioning"><%= advisor.identity.positioning %></p>
          <%- include('partials/trust', data) %>
          <a class="direct-jump" href="#faq">Straight answers, first &darr;</a>
        </div>
        <img src="<%= images.headshot.src %>" alt="<%= images.headshot.alt %>" width="<%= images.headshot.width %>" height="<%= images.headshot.height %>" fetchpriority="high">
      </div>
    </div>
  </section>

  <%- include('partials/faq', data) %>

  <%- include('partials/reviews', data) %>

  <section class="section lifestyle-section" id="lifestyle">
    <div class="container">
      <p class="eyebrow">Off the clock</p>
      <h2><%= advisor.personal.moreAboutMe.title %></h2>
      <div class="lifestyle-grid">
        <img src="<%= advisor.personal.lifestylePhotos[0].src %>" alt="<%= advisor.personal.lifestylePhotos[0].alt %>" width="<%= advisor.personal.lifestylePhotos[0].width %>" height="<%= advisor.personal.lifestylePhotos[0].height %>" loading="lazy">
        <div class="lifestyle-copy"><% advisor.personal.moreAboutMe.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %></div>
      </div>
    </div>
  </section>

  <section class="section compact-story" id="story">
    <div class="container narrow">
      <p class="eyebrow">On the record</p>
      <h2><%= advisor.professional.story.title %></h2>
      <p><%= advisor.professional.story.paragraphs[0] %></p>
      <blockquote class="pull-quote">&ldquo;<%= advisor.professional.story.quote %>&rdquo;<cite><%= advisor.identity.name %></cite></blockquote>
    </div>
  </section>

  <%- include('partials/contact', data) %>
</main>
<%- include('partials/footer', data) %>
<%- include('partials/schema', data) %>
</body></html>
