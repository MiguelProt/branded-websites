<!doctype html>
<html lang="en">
<%- include('partials/head', data) %>
<body class="design-05">
<%- include('partials/nav', data) %>
<main>
  <section class="hero hero-institutional">
    <div class="institutional-bar"><div class="container"><span><%= advisor.compliance.firmName %></span><span><%= advisor.identity.location %></span></div></div>

    <div class="hero-banner">
      <div class="container hero-banner-inner">
        <p class="eyebrow"><%= advisor.identity.headline %></p>
        <p class="hero-banner-title">Retirement planning, made personal.</p>
        <p class="hero-banner-sub">Serving clients nationwide from <%= advisor.identity.location %>.</p>
        <a class="hero-cta" href="#contact">Schedule a conversation</a>
      </div>
    </div>

    <div class="container institution-main">
      <div class="institution-card">
        <p class="eyebrow">Meet your advisor</p>
        <h1><%= advisor.identity.name %></h1>
        <p class="hero-positioning"><%= advisor.identity.positioning %></p>
        <% if (advisor.trust.trustpilot.enabled && advisor.trust.trustpilot.reviewCount) { %>
          <a class="tp-rating-badge" href="<%= advisor.trust.trustpilot.profileUrl %>" target="_blank" rel="noopener noreferrer" aria-label="View Trustpilot profile">
            <p class="tp-review-count">Based on <%= Number(advisor.trust.trustpilot.reviewCount).toLocaleString() %> reviews</p>
            <span class="tp-stars-row" aria-hidden="true">
              <% for (let i = 1; i <= 5; i++) { const fill = Math.max(0, Math.min(1, Number(advisor.trust.trustpilot.rating) - (i - 1))); %>
                <span class="tp-star-cell">
                  <span class="tp-star-fill" style="width:<%= (fill * 100).toFixed(0) %>%"></span>
                  <span class="tp-star-icon"></span>
                </span>
              <% } %>
            </span>
            <span class="tp-logo" aria-hidden="true">
              <span class="tp-logo-star"></span>
              <span class="tp-logo-text">Trustpilot</span>
            </span>
          </a>
        <% } else { %>
          <div class="trust-summary trust-summary--fallback">
            <strong>Professional guidance</strong>
            <span>Clear, personal, no-pressure conversations</span>
          </div>
        <% } %>
        <div class="institution-links">
          <a href="#story">My approach <span aria-hidden="true">&rarr;</span></a>
          <a href="#credentials">Credentials <span aria-hidden="true">&rarr;</span></a>
          <a href="#reviews">Client reviews <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <div class="institution-photo"><img src="<%= images.headshot.src %>" alt="<%= images.headshot.alt %>" width="<%= images.headshot.width %>" height="<%= images.headshot.height %>" fetchpriority="high"></div>
    </div>
  </section>

  <section class="quote-band-section">
    <div class="container quote-band">
      <div class="quote-band-mark" aria-hidden="true"></div>
      <div>
        <blockquote>“<%= advisor.professional.story.quote %>”</blockquote>
        <a class="quote-band-cta" href="#contact">Explore how I can help</a>
      </div>
    </div>
  </section>

  <section class="credential-band" id="credentials">
    <div class="container">
      <p class="band-label">Built on experience, backed by trust</p>
      <%- include('partials/credentials', data) %>
    </div>
  </section>

  <section class="section">
    <div class="container institutional-columns" id="story">
      <div><p class="eyebrow">Advisor philosophy</p><h2><%= advisor.professional.story.title %></h2></div>
      <div><% advisor.professional.story.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %></div>
    </div>
  </section>

  <figure class="photo-break">
    <img src="./assets/images/advisor-meeting.jpg" alt="Advisor reviewing a retirement plan with clients" loading="lazy">
    <figcaption>Every plan starts with a conversation.</figcaption>
  </figure>

  <%- include('partials/reviews', data) %>

  <section class="section lifestyle-section" id="lifestyle">
    <div class="container">
      <p class="eyebrow">Beyond the office</p>
      <h2><%= advisor.personal.moreAboutMe.title %></h2>
      <div class="lifestyle-grid">
        <% const [photo] = advisor.personal.lifestylePhotos; %><img src="<%= photo.src %>" alt="<%= photo.alt %>" width="<%= photo.width %>" height="<%= photo.height %>" loading="lazy">
        <div class="lifestyle-copy"><% advisor.personal.moreAboutMe.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %></div>
      </div>
    </div>
  </section>

  <%- include('partials/faq', data).trim() %>
  <%- include('partials/contact', data) %>
</main>
<%- include('partials/footer', data) %>
<%- include('partials/schema', data) %>
</body></html>
