<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <link rel="canonical" href="<%= seo.canonical %>">
  <link rel="icon" href="<%= seo.favicon %>">
  <meta property="og:type" content="profile">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:image" content="<%= seo.ogImage %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="./styles.css">
</head>
<body class="design-11">
  <a class="d11-skip" href="#main">Skip to content</a>

  <header class="d11-header" data-header>
    <a class="d11-logo" href="#top" aria-label="<%= advisor.identity.name %>, home">
      <span><%= advisor.identity.firstName %></span><%= advisor.identity.lastName %>
    </a>
    <p class="d11-header-note"><%= advisor.identity.headline %><br><%= advisor.identity.location %></p>
    <div class="d11-header-actions">
      <nav class="d11-desktop-nav" aria-label="Main navigation">
        <a href="#story">About</a>
        <a href="#services">Expertise</a>
        <a href="#approach">Professional</a>
        <a href="#reviews">Reviews</a>
        <a href="#contact">Contact</a>
      </nav>
      <button class="d11-menu-toggle" type="button" aria-expanded="false" aria-controls="d11-menu" aria-label="Open navigation" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>
  </header>

  <div class="d11-overlay" data-overlay hidden></div>
  <aside class="d11-menu" id="d11-menu" aria-hidden="true" aria-label="Main navigation" data-menu>
    <p class="d11-kicker">Navigate</p>
    <nav>
      <a href="#story">About</a>
      <a href="#services">Expertise</a>
      <a href="#approach">Approach</a>
      <a href="#reviews">Reviews</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="d11-menu-meta">
      <span>Available nationwide</span>
      <a href="tel:<%= advisor.contact.phone.replace(/[^\d+]/g, '') %>"><%= advisor.contact.phone %></a>
    </div>
  </aside>

  <main id="main">
    <section class="d11-hero" id="top">
      <div class="d11-hero-art" aria-hidden="true"><span></span><i></i></div>
      <div class="d11-hero-photo d11-image-reveal is-visible">
        <img src="<%= design11.heroImage.src %>" alt="<%= design11.heroImage.alt %>" width="<%= design11.heroImage.width %>" height="<%= design11.heroImage.height %>" fetchpriority="high" data-parallax>
      </div>
      <div class="d11-hero-copy">
        <p class="d11-kicker d11-rise">Independent advisor · <%= advisor.identity.location %></p>
        <h1 class="d11-title-lines"><span><%= advisor.identity.firstName %></span><span><%= advisor.identity.lastName %></span></h1>
        <p class="d11-hero-role d11-rise"><%= advisor.identity.headline %></p>
      </div>
      <!-- <a class="d11-scroll" href="#story" aria-label="Scroll to introduction"><span>Scroll · Explore · Scroll · Explore ·</span><i>↓</i></a> -->
    </section>

    <section class="d11-intro d11-section" id="story">
      <div class="d11-container d11-intro-grid">
        <div class="d11-reveal">
          <p class="d11-kicker">A prepared future</p>
          <h2>Clear thinking.<br>Human guidance.</h2>
        </div>
        <div class="d11-intro-copy d11-reveal">
          <p class="d11-lead"><%= advisor.professional.story.quote %></p>
          <p><%= advisor.professional.story.paragraphs[0] %></p>
          <div class="d11-signature" aria-label="<%= advisor.identity.name %>"><%= advisor.identity.firstName %> <span>↗</span></div>
        </div>
      </div>
    </section>

    <section class="d11-services d11-section" id="services">
      <div class="d11-container">
        <div class="d11-section-head d11-reveal">
          <p class="d11-kicker">Areas of focus</p>
          <h2>EXPERTISE</h2>
        </div>
        <div class="d11-service-grid">
          <% design11.services.forEach(service => { %>
            <article class="d11-service d11-reveal">
              <span><%= service.number %></span><h3><%= service.title %></h3><p><%= service.description %></p><i aria-hidden="true">↗</i>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="d11-work-head d11-section" id="approach">
      <div class="d11-container d11-work-title d11-reveal">
        <div><p class="d11-kicker">Experience with a purpose</p><h2>PROFESSIONAL<br>JOURNEY.</h2></div>
        <a class="d11-round-link" href="#contact"><span>Start a<br>conversation</span><i>↗</i></a>
      </div>
    </section>

    <section class="d11-about d11-container" aria-label="Professional and personal background">
      <article class="d11-about-block d11-about-block--professional">
        <div class="d11-about-image d11-reveal">
          <img src="<%= advisor.personal.lifestylePhotos[1].src %>" alt="<%= advisor.personal.lifestylePhotos[1].alt %>" width="<%= advisor.personal.lifestylePhotos[1].width %>" height="<%= advisor.personal.lifestylePhotos[1].height %>" loading="lazy">
        </div>
        <div class="d11-about-copy d11-reveal">
          <p class="d11-kicker">Professional</p>
          <h3><%= advisor.professional.story.title %></h3>
          <% advisor.professional.story.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }); %>
          <div class="d11-credential-row">
            <% advisor.professional.credentials.forEach(credential => { %>
              <div><strong><%= credential.value %></strong><span><%= credential.label %></span></div>
            <% }); %>
          </div>
        </div>
      </article>

      <article class="d11-about-block d11-about-block--personal">
        <div class="d11-about-copy d11-reveal">
          <p class="d11-kicker">About <%= advisor.identity.firstName %></p>
          <h3><%= advisor.personal.moreAboutMe.title %></h3>
          <% advisor.personal.moreAboutMe.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }); %>
        </div>
        <div class="d11-about-image d11-reveal">
          <img src="<%= advisor.personal.lifestylePhotos[0].src %>" alt="<%= advisor.personal.lifestylePhotos[0].alt %>" width="<%= advisor.personal.lifestylePhotos[0].width %>" height="<%= advisor.personal.lifestylePhotos[0].height %>" loading="lazy">
        </div>
      </article>
    </section>

    <section class="d11-statement d11-section">
      <p class="d11-kicker">The philosophy</p>
      <p class="d11-statement-copy d11-reveal"><%= design11.statement %></p>
    </section>

    <section class="d11-testimonials d11-section" id="reviews">
      <div class="d11-container">
        <div class="d11-section-head d11-reveal"><p class="d11-kicker">Client perspective</p><h2>IN THEIR WORDS</h2></div>
        <div class="d11-slider" data-slider tabindex="0" aria-label="Client testimonials carousel">
          <div class="d11-slider-track" data-slider-track>
            <% optional.reviews.forEach((review, index) => { %>
              <figure class="d11-slide" aria-label="Testimonial <%= index + 1 %> of <%= optional.reviews.length %>">
                <span>“</span><blockquote><%= review.quote %></blockquote><figcaption><%= review.author %></figcaption>
              </figure>
            <% }) %>
          </div>
        </div>
        <div class="d11-slider-controls">
          <div class="d11-progress"><i data-progress></i></div>
          <button type="button" data-prev aria-label="Previous testimonial">←</button>
          <button type="button" data-next aria-label="Next testimonial">→</button>
        </div>
        <% if (advisor.trust.trustpilot.enabled) { %><a class="d11-trust" href="<%= advisor.trust.trustpilot.profileUrl %>" target="_blank" rel="noopener noreferrer"><strong><%= advisor.trust.trustpilot.rating %> / 5</strong> on Trustpilot · <%= Number(advisor.trust.trustpilot.reviewCount).toLocaleString() %>+ reviews ↗</a><% } %>
      </div>
    </section>

    <section class="d11-contact" id="contact">
      <div class="d11-contact-form-wrap">
        <p class="d11-kicker">Send a message</p>
        <h2>LET'S TALK</h2>
        <form class="d11-form" method="<%= advisor.contact.form.method %>" action="<%= advisor.contact.form.action %>">
          <% advisor.contact.form.fields.forEach(field => { %>
            <div class="d11-field d11-field--<%= field.type %>">
              <label for="d11-<%= field.name %>"><%= field.label %></label>
              <% if (field.type === 'textarea') { %>
                <textarea id="d11-<%= field.name %>" name="<%= field.name %>" autocomplete="<%= field.autocomplete %>" <%= field.required ? 'required' : '' %>></textarea>
              <% } else { %>
                <input id="d11-<%= field.name %>" name="<%= field.name %>" type="<%= field.type %>" autocomplete="<%= field.autocomplete %>" <%= field.required ? 'required' : '' %>>
              <% } %>
            </div>
          <% }) %>
          <p class="d11-form-note">Your information is confidential and will only be used to respond to your request.</p>
          <button type="submit"><span><%= design11.formSubmitLabel %></span><i aria-hidden="true">↗</i></button>
        </form>
      </div>
      <div class="d11-contact-copy">
        <p class="d11-kicker">Let's talk</p>
        <h2>READY TO<br>PLAN WHAT'S<br>NEXT?</h2>
        <p><%= advisor.contact.intro %></p>
        <p class="d11-availability"><i></i> Available for virtual meetings nationwide</p>
      </div>
    </section>
  </main>

  <footer class="d11-footer">
    <div class="d11-container d11-footer-grid">
      <a class="d11-logo" href="#top"><span><%= advisor.identity.firstName %></span><%= advisor.identity.lastName %></a>
      <nav aria-label="Footer navigation"><a href="#story">About</a><a href="#services">Expertise</a><a href="#reviews">Reviews</a><a href="#contact">Contact</a></nav>
      <div><p><%= advisor.identity.location %></p><a href="tel:<%= advisor.contact.phone.replace(/[^\d+]/g, '') %>"><%= advisor.contact.phone %></a></div>
    </div>
    <div class="d11-container d11-footer-bottom"><span>© <%= new Date().getFullYear() %> <%= advisor.identity.name %></span><span>Independent financial services</span></div>
  </footer>

  <%- include('partials/schema', data) %>
  <script>
    (function () {
      var body = document.body;
      var header = document.querySelector('[data-header]');
      var toggle = document.querySelector('[data-menu-toggle]');
      var menu = document.querySelector('[data-menu]');
      var overlay = document.querySelector('[data-overlay]');
      var lastFocus = null;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function setMenu(open) {
        body.classList.toggle('d11-menu-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        menu.setAttribute('aria-hidden', String(!open));
        overlay.hidden = !open;
        if (open) { lastFocus = document.activeElement; setTimeout(function () { menu.querySelector('a').focus(); }, 80); }
        else if (lastFocus) lastFocus.focus();
      }
      toggle.addEventListener('click', function () { setMenu(!body.classList.contains('d11-menu-open')); });
      overlay.addEventListener('click', function () { setMenu(false); });
      menu.querySelectorAll('a').forEach(function (link) { link.addEventListener('click', function () { setMenu(false); }); });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && body.classList.contains('d11-menu-open')) setMenu(false);
        if (event.key === 'Tab' && body.classList.contains('d11-menu-open')) {
          var focusable = Array.from(menu.querySelectorAll('a, button'));
          var first = focusable[0], last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
      });
      window.addEventListener('scroll', function () { header.classList.toggle('is-compact', window.scrollY > 40); }, { passive: true });

      document.querySelectorAll('.d11-section-head, .d11-work-title, .d11-contact-form-wrap > h2, .d11-contact-copy > h2').forEach(function (heading) {
        heading.classList.add('d11-heading-reveal');
      });
      document.querySelectorAll('.d11-intro-grid > *, .d11-about-copy').forEach(function (item, itemIndex) {
        item.dataset.reveal = itemIndex % 2 ? 'right' : 'left';
      });
      document.querySelectorAll('.d11-service').forEach(function (item, itemIndex) {
        item.style.setProperty('--d11-delay', (itemIndex * 90) + 'ms');
      });
      document.querySelectorAll('.d11-credential-row > div, .d11-field').forEach(function (item, itemIndex) {
        item.classList.add('d11-child-reveal');
        item.style.setProperty('--d11-delay', ((itemIndex % 5) * 70) + 'ms');
      });

      var reveals = document.querySelectorAll('.d11-reveal, .d11-image-reveal, .d11-heading-reveal, .d11-child-reveal');
      if (reduced || !('IntersectionObserver' in window)) reveals.forEach(function (item) { item.classList.add('is-visible'); });
      else {
        var observer = new IntersectionObserver(function (entries) { entries.forEach(function (entry) { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }); }, { threshold: .12 });
        reveals.forEach(function (item) { observer.observe(item); });
      }

      if (!reduced && matchMedia('(min-width: 992px)').matches) {
        var photo = document.querySelector('[data-parallax]');
        var ticking = false;
        window.addEventListener('scroll', function () { if (!ticking) requestAnimationFrame(function () { photo.style.transform = 'translate3d(0,' + Math.min(60, scrollY * .06) + 'px,0) scale(1.035)'; ticking = false; }); ticking = true; }, { passive: true });
      }

      var track = document.querySelector('[data-slider-track]');
      var slides = Array.from(track.children);
      var progress = document.querySelector('[data-progress]');
      var index = 0;
      function go(next) { index = (next + slides.length) % slides.length; track.style.transform = 'translate3d(' + (-index * 84) + '%,0,0)'; progress.style.transform = 'scaleX(' + ((index + 1) / slides.length) + ')'; }
      document.querySelector('[data-prev]').addEventListener('click', function () { go(index - 1); });
      document.querySelector('[data-next]').addEventListener('click', function () { go(index + 1); });
      document.querySelector('[data-slider]').addEventListener('keydown', function (event) { if (event.key === 'ArrowLeft') go(index - 1); if (event.key === 'ArrowRight') go(index + 1); });
      var startX = 0;
      track.addEventListener('pointerdown', function (event) { startX = event.clientX; track.setPointerCapture(event.pointerId); });
      track.addEventListener('pointerup', function (event) { var delta = event.clientX - startX; if (Math.abs(delta) > 45) go(index + (delta < 0 ? 1 : -1)); });
      go(0);
    })();
  </script>
</body>
</html>
