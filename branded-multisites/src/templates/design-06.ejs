<!doctype html>
<html lang="en">
<%- include('partials/head', data) %>
<body class="design-06">
<%- include('partials/nav', data) %>

<section class="hero dc-hero">
  <div class="container narrow dc-hero-inner">
    <p class="eyebrow"><%= advisor.identity.headline %></p>
    <blockquote class="dc-hero-quote">&ldquo;<%= advisor.professional.story.quote %>&rdquo;</blockquote>
    <div class="dc-hero-person">
      <img src="<%= images.headshot.src %>" alt="<%= images.headshot.alt %>" width="<%= images.headshot.width %>" height="<%= images.headshot.height %>" fetchpriority="high">
      <div><strong><%= advisor.identity.name %></strong><span><%= advisor.identity.location %></span></div>
    </div>
    <%- include('partials/trust', data) %>
  </div>
</section>

<div class="container dc-layout">
  <aside class="dc-aside" id="contact" aria-label="Contact">
    <div class="dc-contact-card">
      <p class="eyebrow">Let&rsquo;s talk</p>
      <img class="dc-contact-photo" src="<%= images.contactPhoto.src %>" alt="<%= images.contactPhoto.alt %>" width="<%= images.contactPhoto.width %>" height="<%= images.contactPhoto.height %>" loading="lazy">
      <h2><%= advisor.contact.title %></h2>
      <p class="dc-contact-intro"><%= advisor.contact.intro %></p>
      <p class="dc-contact-location"><%= advisor.identity.location %></p>
      <p class="dc-contact-phone"><a href="tel:<%= advisor.contact.phone.replace(/[^\d+]/g, '') %>"><%= advisor.contact.phone %></a></p>

      <form class="dc-contact-form" method="<%= advisor.contact.form.method %>" action="<%= advisor.contact.form.action %>">
        <% advisor.contact.form.fields.forEach(field => { %>
          <div class="field">
            <label for="<%= field.name %>"><%= field.label %></label>
            <% if (field.type === 'textarea') { %>
              <textarea id="<%= field.name %>" name="<%= field.name %>" autocomplete="<%= field.autocomplete %>" <%= field.required ? 'required' : '' %>></textarea>
            <% } else { %>
              <input id="<%= field.name %>" name="<%= field.name %>" type="<%= field.type %>" autocomplete="<%= field.autocomplete %>" <%= field.required ? 'required' : '' %>>
            <% } %>
          </div>
        <% }) %>
        <p class="confidentiality">Your information is confidential and used only to respond to your request.</p>
        <button type="submit"><%= advisor.contact.form.submitLabel %></button>
      </form>
    </div>
  </aside>

  <div class="dc-main-col">
    <section class="section dc-credentials" id="credentials">
      <p class="eyebrow">Credentials</p>
      <%- include('partials/credentials', data) %>
    </section>

    <section class="section dc-story" id="story">
      <p class="eyebrow">Philosophy</p>
      <h2>How I think about retirement planning</h2>
      <% advisor.professional.story.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %>
    </section>

    <section class="section dc-lifestyle" id="lifestyle">
      <p class="eyebrow">Beyond retirement planning</p>
      <h2><%= advisor.personal.moreAboutMe.title %></h2>
      <img class="dc-lifestyle-photo" src="<%= advisor.personal.lifestylePhotos[0].src %>" alt="<%= advisor.personal.lifestylePhotos[0].alt %>" width="<%= advisor.personal.lifestylePhotos[0].width %>" height="<%= advisor.personal.lifestylePhotos[0].height %>" loading="lazy">
      <% advisor.personal.moreAboutMe.paragraphs.forEach(paragraph => { %><p><%= paragraph %></p><% }) %>
    </section>

    <%- include('partials/reviews', data) %>
    <%- include('partials/faq', data) %>
  </div>
</div>

<%- include('partials/footer', data) %>
<%- include('partials/schema', data) %>
</body></html>
